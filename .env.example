# Copiá este archivo como .env.local y completá los valores.
# .env.local está ignorado por git: nunca lo subas al repositorio.

# --- Supabase (Project Settings → Data API / API Keys) ---
# URL del proyecto, por ejemplo https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (empieza con sb_publishable_). Es pública por diseño: la protege RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (empieza con sb_secret_). SOLO servidor y scripts. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Sitio ---
# Dirección pública de la app, usada en los enlaces de los emails de Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Solo en tu máquina (CLI de Supabase para migraciones) ---
# Identificador del proyecto: la parte "abcdefghijkl" de la URL.
SUPABASE_PROJECT_REF=
# Token personal: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Contraseña de la base de datos (Project Settings → Database).
SUPABASE_DB_PASSWORD=

# --- Solo en el sitio público (Vercel) ---
# 1 = sin pantalla de ingreso: la demo sigue abierta, pero nadie puede iniciar sesión ni recuperar
# contraseñas desde internet. Dejalo vacío en tu máquina para entrar con tu cuenta.
LOGIN_DISABLED=
